{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-auth-usage-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  // nodejs_compat + populate so @repo/env (t3 over process.env) can read
  // the .dev.vars values at runtime.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "durable_objects": {
    "bindings": [{ "name": "USAGE_DO", "class_name": "UsageDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageDurableObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-auth-usage",
      // Local dev uses a local sqlite under .wrangler; replace with the real id
      // for remote, or let alchemy provision it on deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/src/migrations"
    }
  ],
  // Fast session store (better-auth secondaryStorage). Local dev uses a local KV
  // under .wrangler; alchemy provisions + binds the real namespace on deploy.
  "kv_namespaces": [
    { "binding": "SESSION_KV", "id": "00000000000000000000000000000000" }
  ],
  "dev": { "port": 3000 }
}

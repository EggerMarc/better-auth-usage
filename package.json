{
  "name": "better-auth-usage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "@cloudflare/workers-types": "^4.20260625.1",
      "@types/node": "^22.13.14",
      "better-auth": "^1.3.12",
      "alchemy": "^0.91.2",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "zod": "^4.1.12"
    }
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "dev": "turbo dev",
    "db:generate": "cd apps/server && bunx @better-auth/cli generate --config ../../packages/auth/src/cli.ts --output ../../packages/db/src/schema/auth.ts -y",
    "db:migrate": "cd packages/db && bunx drizzle-kit generate",
    "db:apply": "cd apps/server && bunx wrangler d1 migrations apply DB --local",
    "db:setup": "bun run db:generate && bun run db:migrate && bun run db:apply",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build --filter=@eggermarc/better-auth-usage && changeset publish",
    "deploy": "turbo -F @repo/infra deploy && bun --filter=docs run deploy",
    "deploy:docs": "bun --filter=docs run deploy",
    "destroy": "turbo -F @repo/infra destroy"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@repo/config": "workspace:*",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  }
}

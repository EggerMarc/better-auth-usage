# Deploy secrets (public URLs are hardcoded in alchemy.run.ts; D1 is provisioned
# by alchemy, no DB URL needed).
#
# Cloudflare auth comes from `wrangler login` or CLOUDFLARE_API_TOKEN.

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Alchemy CloudflareStateStore — generate once with `openssl rand -base64 32`.
# ALCHEMY_STATE_TOKEN must be the SAME across all deploys on this CF account.
# ALCHEMY_PASSWORD encrypts secrets at rest in the state store (keep it stable).
ALCHEMY_STATE_TOKEN=replace-with-openssl-rand-base64-32
ALCHEMY_PASSWORD=replace-with-openssl-rand-base64-32
